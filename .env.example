# Copy this file to .env.local for local development.
# Production/Preview values must be set in Vercel:
# Project Settings → Environment Variables.

# Pexels — https://www.pexels.com/api/
# Free tier: 200 requests/hour, 20.000 requests/month.
PEXELS_API_KEY=

# Freesound — https://freesound.org/apiv2/apply/
# Token-only auth. Used for sound search + preview MP3s.
FREESOUND_API_KEY=

# Unsplash — https://unsplash.com/developers
# Free tier: 50 requests/hour (demo) / 5000/hour (production after review).
# Approval pending — leave empty until granted.
UNSPLASH_ACCESS_KEY=
